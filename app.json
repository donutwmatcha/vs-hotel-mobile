      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.vshotelmobile"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/56a7b0ed-298a-4d7f-9b61-c7e3060621e5"
    },
    "extra": {
      "eas": {
        "projectId": "56a7b0ed-298a-4d7f-9b61-c7e3060621e5"
      }
    },
    "plugins": [
      "expo-web-browser"
    ]
  }
}
